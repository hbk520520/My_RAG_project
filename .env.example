# ==========================================
# 环境变量样例 —— 复制为 .env 后填入真实值
# ==========================================
# config.yaml 里用 ${VAR} / ${VAR:-默认值} 引用这些变量。
# .env 已被 .gitignore 忽略，切勿把真实 Key 提交进仓库。

# --- 必填：LLM API ---
# config.yaml: llm.api_key = "${DEEPSEEK_API_KEY}"
DEEPSEEK_API_KEY=sk-your-real-key-here
AGENT_API_TOKEN=replace-with-a-long-random-team-token

# --- 可选：基础设施地址（不设则用 config.yaml 中的默认值）---
# config.yaml: kafka.bootstrap_servers = "${KAFKA_BOOTSTRAP:-localhost:9092}"
KAFKA_BOOTSTRAP=localhost:9092

# config.yaml: redis.url = "${REDIS_URL:-redis://localhost:6379}"
REDIS_URL=redis://localhost:6379

# --- 可选：Worker 角色（容器内由 k8s Deployment 指定）---
# planner | retriever | grader | replanner | reasoner
# WORKER_TYPE=planner

# --- 可选：SPACE 沙箱后端（默认关闭，只有 backend=space 时才读取）---
# 模板必须是不可变摘要引用：<name>@sha256:<12-64 位小写十六进制>（建议完整 64 位）。
# 不要把真实 token 写进 config.yaml 或提交到仓库。
SPACE_API_URL=
SPACE_DATA_PLANE_URL=
SPACE_API_TOKEN=
SPACE_TEMPLATE=
